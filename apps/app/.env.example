# Copy to .env and fill in. Never commit .env. Production values live on the Vercel project.
# VITE_* values are shipped to the browser: never put a secret in one.

VITE_APP_URL=http://localhost:4321

# Privy dashboard → App settings. Email, Google and Apple login; EVM embedded wallets.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# Supabase → Project settings → API. The service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Robinhood Chain (4663) RPC. May embed an API key: never log it. The public endpoint
# https://rpc.mainnet.chain.robinhood.com is free but rate limited: dev and testing only.
ROBINHOOD_RPC_URL=
# ERC-4337 bundler serving chain 4663. Alchemy's RPC URL doubles as its bundler (EntryPoint v0.8).
BUNDLER_URL=

# Signs paymaster sponsorships only; holds no funds. Its address is the paymaster's `signer`.
PAYMASTER_SIGNER_KEY=
# Hot wallet that is the treasury and tops up the paymaster. Keep only a little in it.
OPS_PRIVATE_KEY=
# Receives fees. Defaults to the ops wallet; the top-up cron only runs when they match.
TREASURY_ADDRESS=

# Any long random string. Vercel sends it as `Authorization: Bearer` to /api/cron/*.
CRON_SECRET=

# Integrator fee on trades, in basis points. Unset = no trading fee.
TRADE_FEE_BPS=

# Web push. Unset = notifications stay in the app's feed.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email through Resend. Unset = nothing is sent.
RESEND_API_KEY=

# PostHog. Unset = analytics off.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=

# "Verify first" fork checks only (`moon run contracts:verify`). A canonical Stock Token (or USDG)
# from Robinhood's registry, and an address that holds it.
VERIFY_TOKEN=
VERIFY_HOLDER=
VERIFY_USDG_HOLDER=
